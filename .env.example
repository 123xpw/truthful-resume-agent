# Copy to .env and fill in a real key. .env is ignored by Git.
RESUME_AGENT_LLM_API_URL=https://api.deepseek.com/chat/completions
RESUME_AGENT_LLM_MODEL=deepseek-chat
RESUME_AGENT_LLM_API_KEY=
RESUME_AGENT_LLM_TIMEOUT_SECONDS=30
RESUME_AGENT_LLM_MAX_RETRIES=2
RESUME_AGENT_WORKFLOW_TIMEOUT_SECONDS=90
# Web JD analysis stays deterministic and fast by default. Enable only after
# the local FastEmbed model has been prepared outside an HTTP request.
RESUME_AGENT_WEB_SEMANTIC_ENABLED=0
# Keep preview until backup/restore and parallel record checks pass with your data copy.
RESUME_AGENT_DATA_MODE=preview

# Optional read-only Feishu application-ledger sync. Keep real credentials in
# the ignored local .env only. The first visible worksheet is used when
# RESUME_AGENT_FEISHU_SHEET_ID is blank.
RESUME_AGENT_FEISHU_SPREADSHEET_URL=
RESUME_AGENT_FEISHU_APP_ID=
RESUME_AGENT_FEISHU_APP_SECRET=
RESUME_AGENT_FEISHU_SHEET_ID=
RESUME_AGENT_FEISHU_RANGE=A1:Z500
RESUME_AGENT_FEISHU_TIMEOUT_SECONDS=10
