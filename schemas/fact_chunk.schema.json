{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactChunk",
  "type": "object",
  "required": ["id", "source_file", "source_section", "fact_type", "tags", "claim", "evidence", "boundary", "risk"],
  "properties": {
    "id": { "type": "string" },
    "source_file": { "type": "string" },
    "source_section": { "type": "string" },
    "fact_type": {
      "type": "string",
      "enum": ["education", "internship", "project", "skill", "award"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claim": { "type": "string" },
    "evidence": { "type": "string" },
    "boundary": { "type": "string" },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  }
}
