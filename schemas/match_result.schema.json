{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatchResult",
  "type": "object",
  "required": ["requirement_id", "fact_ids", "match_level", "reason", "recommended_action"],
  "properties": {
    "requirement_id": { "type": "string" },
    "fact_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "match_level": {
      "type": "string",
      "enum": ["strong", "weak", "not_writable"]
    },
    "reason": { "type": "string" },
    "recommended_action": {
      "type": "string",
      "enum": ["use", "rewrite_lower_risk", "downrank", "remove", "needs_study", "needs_project_evidence"]
    }
  }
}
